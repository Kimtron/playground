{
  "name": "bonbon",
  "version": "1.0.0",
  "description": "BonBon - A super library combining Vite and Rollup for next-gen bundling. Vite for development, Rollup as fallback.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:server": "node server.js",
    "build": "vite build",
    "build:rollup": "rollup -c",
    "preview": "vite preview",
    "watch": "vite build --watch"
  },
  "keywords": ["vite", "rollup", "node", "express", "bootstrap", "tailwind", "super-library"],
  "author": "Kimberley Hale",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@vitejs/plugin-legacy": "^5.0.0",
    "rollup": "^3.29.0",
    "tailwindcss": "^3.3.0",
    "vite": "^5.0.0"
  }
}
